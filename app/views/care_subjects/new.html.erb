<!-- ケア対象者の登録 -->
<div id="registration-page" style="padding: 20px; max-width: 500px; margin: 0 auto; color: #fff;">
  
  <div style="text-align: center; margin-bottom: 30px;">
    <h1 style="font-size: 24px; margin-bottom: 10px;">ケア対象者の登録</h1>
  </div>

  <%= form_with(model: @care_subject, url: care_subjects_path, scope: :care_subject, local: true, data: { turbo: false }) do |f| %>
    
    <% if @care_subject && @care_subject.errors.any? %>
      <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; border-radius: 8px; padding: 15px; margin-bottom: 20px; color: #fca5a5; font-size: 14px;">
        <p style="font-weight: bold; margin-top: 0;">⚠️ 入力内容にエラーがあります：</p>
        <ul style="margin: 0; padding-left: 20px;">
          <% @care_subject.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="margin-bottom: 25px;">
      <%= f.label :nickname, "ケアを受ける方のニックネーム", style: "display: block; color: #ccc; margin-bottom: 8px; font-size: 14px;" %>
      <%= f.text_field :nickname, placeholder: "例：おじいちゃん、お父さん", 
          style: "width: 100%; padding: 14px; border-radius: 8px; border: 1px solid #444; background: #111; color: #fff; box-sizing: border-box;" %>
    </div>

    <%= f.submit "利用を開始する", 
        style: "width: 100%; padding: 16px; background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: #fff; border: none; border-radius: 8px; font-weight: bold; font-size: 16px; cursor: pointer;" %>
  <% end %>

  <div style="text-align: center; margin-top: 20px;">
    <%= link_to "ログアウトする", destroy_user_session_path, method: :delete, style: "color: #888; text-decoration: none; font-size: 13px;" %>
  </div>
</div>