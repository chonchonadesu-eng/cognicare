<!--✨新規登録-->

<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-logo">🧠</div>
    <h1 class="auth-title">新規登録</h1>

    <%# --- メールアドレス登録フォーム --- %>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

      <div class="auth-field">
        <%= f.label :email, "メールアドレス", class: "auth-label" %>
        <%= f.email_field :email, autofocus: true, class: "auth-input", placeholder: "example@email.com" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "パスワード", class: "auth-label" %>
        
        <div data-controller="password-toggle" style="position: relative;">
          <%= f.password_field :password, 
              class: "auth-input", 
              placeholder: "••••••••", 
              id: "new-password-field", 
              data: { password_toggle_target: "input" },
              style: "padding-right: 40px;" %>

          <button type="button" 
                  data-action="password-toggle#toggle" 
                  data-password-toggle-target="button"
                  style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; font-size: 16px;">
            👁️
          </button>
        </div>

      <% if @minimum_password_length %>
    <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0;">※ 半角英数字 <%= @minimum_password_length %> 文字以上</p>
  <% end %>

  </div>

      <%= f.submit "新規登録を完了する", class: "auth-btn auth-btn--primary", id: "submit-button" %>
    <% end %>

    <div class="auth-links" style="margin-top: 24px;">
      <%= link_to "すでにアカウントをお持ちの方", new_session_path(resource_name), class: "auth-link" %>
    </div>

  </div>
</div>