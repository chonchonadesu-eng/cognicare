<!-- ログインページ -->

<div class="auth-wrap">
  <div class="auth-card">

    <div class="auth-logo">&#x1F9E0;</div>
    <h1 class="auth-title">&#x30ED;&#x30B0;&#x30A4;&#x30F3;</h1>
    <p class="auth-sub">&#x8A8D;&#x77E5;&#x75C7;&#x30BF;&#x30A4;&#x30D7;&#x30C1;&#x30A7;&#x30C3;&#x30AB;&#x30FC;</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <div class="auth-field">
        <%= f.label :email, "&#x30E1;&#x30FC;&#x30EB;&#x30A2;&#x30C9;&#x30EC;&#x30B9;".html_safe, class: "auth-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "auth-input", placeholder: "example@email.com" %>
      </div>

      <%# 👇 パスワード(👁️)（🔒） %>
      <div class="auth-field">
        <%= f.label :password, "&#x30D1;&#x30B9;&#x30EF;&#x30FC;&#x30C9;".html_safe, class: "auth-label" %>
        
        <div data-controller="password-toggle" style="position: relative;">
          <%= f.password_field :password, autocomplete: "current-password",
              class: "auth-input", placeholder: "••••••••", 
              id: "login-password-field",
              data: { password_toggle_target: "input" },
              style: "padding-right: 40px;" %>

          <button type="button" 
                  data-action="password-toggle#toggle" 
                  data-password-toggle-target="button"
                  style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; font-size: 16px;">
            👁️
          </button>
        </div>
      </div>

      <%= f.submit "ログイン", class: "auth-btn auth-btn--primary" %>
    <% end %>

    <div class="auth-links">
      <%= link_to "アカウントを作る", new_registration_path(resource_name), class: "auth-link" %>
      <%= link_to "パスワードを忘れた方", new_password_path(resource_name), class: "auth-link" %>
      <%= link_to "確認メールが届かない方", new_confirmation_path(resource_name), class: "auth-link" %>
    </div>

  </div>
</div>