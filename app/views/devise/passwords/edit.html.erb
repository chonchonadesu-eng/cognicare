<!-- 届いたメールのURLをクリックした後の「変更」ページ -->
<div style="max-width: 500px; margin: 40px auto; padding: 30px; background-color: #0f172a; border: 1px solid #1e293b; border-radius: 12px; font-family: sans-serif; color: #e2e8f0;">

  <h2 style="font-size: 20px; font-weight: bold; color: #ffffff; margin-bottom: 24px; border-bottom: 2px solid #1d4ed8; padding-bottom: 8px;">
    🔒 パスワードの再設定
  </h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= f.hidden_field :reset_password_token %>
    
    <div style="margin-bottom: 20px;">
  <%= f.label :password, "新しいパスワード", style: "display: block; font-size: 14px; font-weight: 600; color: #cbd5e1; margin-bottom: 6px;" %>

  <div data-controller="password-toggle" style="position: relative;">
    
    <%= f.password_field :password, 
        autofocus: true, 
        autocomplete: "new-password", 
        id: "password-field", 
        data: { password_toggle_target: "input" }, 
        style: "width: 100%; box-sizing: border-box; background-color: #1e293b; color: #ffffff; border: 1px solid #475569; padding: 10px 12px; border-radius: 6px; font-size: 14px; outline: none; padding-right: 40px;" %>

    <button type="button" 
            data-action="password-toggle#toggle" 
            data-password-toggle-target="button"
            style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; font-size: 16px;">
      👁️
    </button>
  </div>

  <% if @minimum_password_length %>
    <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0;">※ 半角英数字 <%= @minimum_password_length %> 文字以上</p>
  <% end %>
</div>

    <div style="margin-bottom: 28px;">
      <%= f.label :password_confirmation, "新しいパスワード（確認用）", style: "display: block; font-size: 14px; font-weight: 600; color: #cbd5e1; margin-bottom: 6px;" %>

      <div data-controller="password-toggle" style="position: relative;">
        
        <%= f.password_field :password_confirmation, 
            autocomplete: "new-password", 
            id: "password-confirmation-field", 
            data: { password_toggle_target: "input" }, 
            style: "width: 100%; box-sizing: border-box; background-color: #1e293b; color: #ffffff; border: 1px solid #475569; padding: 10px 12px; border-radius: 6px; font-size: 14px; outline: none; padding-right: 40px;" %>

        <button type="button" 
                data-action="password-toggle#toggle" 
                data-password-toggle-target="button"
                style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; font-size: 16px;">
          👁️
        </button>
      </div>

    </div>

    <div style="margin-bottom: 24px;">
      <%= f.submit "パスワードを変更する", style: "width: 100%; background-color: #1d4ed8; color: #ffffff; border: 1px solid #60a5fa; padding: 12px; border-radius: 6px; font-weight: bold; font-size: 15px; cursor: pointer; transition: background 0.2s;" %>
    </div>
  <% end %>

  <hr style="border: 0; border-top: 1px solid #1e293b; margin: 20px 0;">

  <div style="text-align: center; font-size: 14px; display: flex; flex-direction: column; gap: 12px;">
    
    <% if controller_name != 'sessions' %>
      <%= link_to "ログイン画面に戻る", new_session_path(resource_name), style: "color: #94a3b8; text-decoration: none;" %>
    <% end %>

    <% if devise_mapping.registerable? && controller_name != 'registrations' %>
      <%= link_to "新規アカウント登録", new_registration_path(resource_name), style: "color: #94a3b8; text-decoration: none;" %>
    <% end %>

  </div>
</div>
