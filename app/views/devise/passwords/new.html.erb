<!-- 再設定メールの「送信を頼む」ページ -->
<div class="auth-wrap">
  <div class="auth-card">
    
    <div class="auth-logo">🔑</div>
    <h1 class="auth-title">パスワード再設定</h1>
    <p class="auth-sub">登録したメールアドレスを入力してください。<br>再設定用のリンクをお送りします。</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="auth-field">
        <%= f.label :email, "メールアドレス", class: "auth-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", 
            class: "auth-input", placeholder: "example@email.com" %>
      </div>

      <%= f.submit "再設定メールを送信する", class: "auth-btn auth-btn--primary" %>
    <% end %>

    <div class="auth-links">
      <%= link_to "ログインに戻る", new_session_path(resource_name), class: "auth-link" %>
      <%= link_to "新規登録はこちら", new_registration_path(resource_name), class: "auth-link" %>
    </div>

  </div>
</div>