<%# 🧠 %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div id="dementia-checker"
     data-controller="dementia-checker"
     data-dementia-checker-analyze-url-value="<%= analyze_dementia_checker_index_path %>"
     data-dementia-checker-categories-value="<%= @symptom_categories.to_json %>"
     data-dementia-checker-types-value="<%= @dementia_types.to_json %>">

  <%# ========== INTRO SCREEN ========== --%>
  <div data-dementia-checker-target="introScreen">
    <div class="dc-hero">
      <div class="dc-hero__icon">&#x1F9E0;</div>
      <h1 class="dc-hero__title">
        症状から読み解く、<br>
        <em class="dc-hero__accent">認知症タイプ</em>
      </h1>
      <p class="dc-hero__desc">
        日頃から気になる症状にチェックを入れるだけで、認知症のタイプの可能性を割り出す
      </p>
    </div>

    <div class="dc-features">
      <div class="dc-feature-card">&#x2705; <strong>30項目チェック</strong><br><small>5カテゴリ・各6項目</small></div>
      <div class="dc-feature-card">&#x1F50D; <strong>4タイプの可能性</strong><br><small>4大認知症の傾向を分析</small></div>
    </div>

    <div class="dc-disclaimer dc-disclaimer--warning">
      &#x26A0;&#xFE0F; このツールは<strong>医療診断ではありません</strong>。
      症状の傾向を参考にするためのものです。正確な診断は必ず医師・専門機関にご相談ください。
    </div>

    <div class="dc-center">
      <button class="dc-btn dc-btn--primary"
              data-action="click->dementia-checker#startCheck">
        チェックを始める &rarr;
      </button>
      <p class="dc-time-note">所要時間：約3〜5分</p>
    </div>
  </div>

  <%# すでにアカウントがある人向けのログイン案内 %>
      <% unless user_signed_in? %>
        <div style="margin-top: 16px; text-align: center;">
          <%= link_to "ログインはこちら", new_user_session_path, 
                      style: "font-size: 0.8rem; color: #94a3b8; text-decoration: underline;" %>
        </div>
      <% end %>
  

  <%# ========== CHECK SCREEN ========== %>
  <div data-dementia-checker-target="checkScreen" class="dc-hidden">

    <div class="dc-progress-wrap">
      <div class="dc-progress-labels">
        <span data-dementia-checker-target="progressLabel">1 / 5 カテゴリ</span>
        <span data-dementia-checker-target="checkedLabel" class="dc-checked-label">0項目チェック済み</span>
      </div>
      <div class="dc-progress-bar">
        <div class="dc-progress-fill" data-dementia-checker-target="progressFill"></div>
      </div>
    </div>

    <div class="dc-tabs" data-dementia-checker-target="categoryTabs"></div>

    <div class="dc-cat-header">
      <div class="dc-cat-icon" data-dementia-checker-target="catIcon"></div>
      <div>
        <h2 class="dc-cat-title" data-dementia-checker-target="catTitle"></h2>
        <p class="dc-cat-inst">当てはまるものをすべて選んでください</p>
      </div>
      <span class="dc-selected-badge dc-hidden" data-dementia-checker-target="selectedBadge"></span>
    </div>

    <div class="dc-symptoms" data-dementia-checker-target="symptomList"></div>

    <div class="dc-nav">
      <button class="dc-btn dc-btn--ghost"
              data-action="click->dementia-checker#prevCategory"
              data-dementia-checker-target="prevBtn">&larr; 前へ</button>
      <button class="dc-btn dc-btn--primary"
              data-action="click->dementia-checker#nextCategory"
              data-dementia-checker-target="nextBtn">次のカテゴリへ &rarr;</button>
    </div>
  </div>

  <%# ========== RESULT SCREEN ========== %>
  <div data-dementia-checker-target="resultScreen" class="dc-hidden">
    <div class="dc-result-header">
      <h2 class="dc-result-title">チェック結果</h2>
      <p class="dc-result-sub" data-dementia-checker-target="resultSub"></p>
    </div>

    <div class="dc-top-result" data-dementia-checker-target="topResult"></div>

    <div class="dc-card">
      <div data-dementia-checker-target="distribution"></div>
    </div>

    <div class="dc-section-label" style="margin: 20px 0 10px;">各タイプの詳細とケアアドバイス</div>
    <div data-dementia-checker-target="detailCards"></div>
    
    <div class="result-navigation" style="margin-top: 40px; padding: 20px; border-top: 1px solid #2d3748; text-align: center;">
      <% if user_signed_in? && @care_subject.present? %>
        <%= form_with url: care_subject_check_records_path(@care_subject), local: true, method: :post, data: { turbo: false, dementia_checker_target: "saveForm" }, style: "width: 100%; max-width: 450px; margin: 0 auto 20px;" do |f| %>
           
           <%= f.hidden_field :recorded_on, value: params[:recorded_on] || Date.today %>
           <input type="hidden" name="checked_ids[]" data-dementia-checker-target="hiddenCheckedIds" value="">

           <p style="color: #a3e635; font-weight: bold; margin-bottom: 15px;">✨ チェックが完了しました！</p>
           
           <%= f.submit "この内容で行動記録を保存", 
                        class: "dc-btn dc-btn--primary", 
                        style: "width: 100%; cursor: pointer; background-color: #1d4ed8; border-color: #1d4ed8; padding: 12px 16px; font-size: 14px; box-sizing: border-box;" %>
        <% end %>
      <% else %>
        <div class="sub-unlock-card" style="background: rgba(124, 158, 255, 0.1); border: 1px solid #7c9eff; border-radius: 12px; padding: 20px; margin-bottom: 20px;">
          <p style="font-size: 14px; color: #e2e8f0; margin-bottom: 12px; line-height: 1.6;">
            チェック結果をカレンダーに保存するには、<br>
            ログインが必要です。
          </p>
          <%= link_to "ログインして始める", new_user_session_path, 
                      class: "dc-btn dc-btn--primary", 
                      style: "background-color: #7c9eff; border-color: #7c9eff; display: inline-block; text-decoration: none;" %>
        </div>
      <% end %>

      <div style="margin-top: 20px;">
        <button class="dc-btn dc-btn--ghost"
                data-action="click->dementia-checker#reset"
                style="font-size: 0.9rem;">
          もう一度チェックし直す
        </button>
      </div>
    </div>

    <div class="dc-disclaimer dc-disclaimer--warning" style="margin-top:20px;">
      &#x26A0;&#xFE0F; <strong>免責事項</strong><br>
      このツールの結果は医療診断ではありません。正確な診断には医師による診察・各種検査が必要です。
      気になる症状がある場合は、かかりつけ医・もの忘れ外来・地域総合支援センターにご相談ください。
    </div>
  </div>

</div>